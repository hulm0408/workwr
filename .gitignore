# ⚠️ SECRETS — ye kabhi git/GitHub par nahi jaane chahiye!
# (Pehle .env live BOT_TOKEN ke saath is PUBLIC repo me committed thi —
#  woh token ab REVOKE karna padega, dekho README ka Security section.)
.env
.env.*
!.env.example

# Dependencies (npm install / npm ci se wapas aa jate hain)
node_modules/

# Test isolation — tests yahan apna alag DB banate hain,
# production data/db.json KO KABHI chhune nahi (warna mock URLs persist
# karke bot "fetch failed" karne lagta tha)
test-data/

# Runtime data / scratch
data/*.tmp
data/db.json.corrupt-*
data/bot.lock
data/db.json
*.log
accounts.json

# Telegram spare-account login secrets — session = full account access.
# Add Telegram Account bot ke andar ye files 0600 permissions se banata hai;
# inhe git/GitHub/chat me kabhi mat bhejo.
data/telegram.session
data/telegram-api.json
*.session
telegram.session
telegram-api.json

# 🗂 Session JSON files (login ke baad banti hain) — credentials, git me kabhi nahi.
data/session-files/
