# ===== Swiggy Fresh Bot — env =====
# ⚠️ YE FILE (.env) KABHI GITHUB PAR MAT DAALNA — token leak = bot hijack.
# BotFather se token lo aur yahan paste karo (REQUIRED)
BOT_TOKEN=

# Kaun chala sakta hai (comma-separated Telegram IDs). Khali chhodoge to
# store ke bossIds + default owner allow honge. Apni ID bot ko /start
# dabane par dikh jati hai agar allow na ho.
OWNER_IDS=

# ---- Chrome (OPTIONAL — sirf tab jab bot bole "Chrome nahi mila") ----
# puppeteer-core ke saath browser bundled NAHI aata; bot system Chrome/
# Chromium/Edge khud dhoondhta hai. Na mile to yahan full path do:
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Linux par browser window chhupakar chalta hai (headless). Force karna ho:
# HEADLESS=1

# ---- Batch tuning (OPTIONAL — sab kuch bot ke ⚙️ Settings menu se bhi badal
# sakte hain; wahi pehle prefer hota hai. Ye values sirf fallback hain.) ----
PREMIUM_BATCH_TARGET=100
# Ek saath parallel lanes (1-10). Asal lanes distinct proxy IPs + 1 direct
# route tak limited hongi; Settings → ⚡ Parallel se bhi badal sakte hain.
PREMIUM_BATCH_CONCURRENCY=10
PREMIUM_BATCH_MAX_MINUTES=120
PREMIUM_BATCH_GAP_MS=6000
PREMIUM_RATE_LIMIT_BACKOFF_MS=900000
PREMIUM_OTP_WAIT_MS=3000
PREMIUM_OTP_TIMEOUT_MS=90000
# Device last-seen base window: pehle is window ki forwarded-SMS activity
# wala device try hota hai, phir window double hoti hai. Quick scan me
# usable SMS timestamp na mile to clients-ONLINE fallback process hota hai.
# Default 60000 (60s).
# Sakht mode (sirf pichhle 10s me active): 10000 · Band karna ho to: 0
# PREMIUM_DEVICE_ACTIVE_WINDOW_MS=60000
# Ek refill me quick device scan ka max time; iske baad best probed/ONLINE
# device process hota hai, full pool scan ka wait nahi. Default 12000.
# PREMIUM_DEVICE_SCAN_BUDGET_MS=12000
# Offline devices bhi try karne ho to '1':
# PREMIUM_ALLOW_OFFLINE_DEVICES=1

# ---- Proxies (OPTIONAL — bot ke ⚙️ Settings → 🔀 Proxies se add kar sakte
# hain; wahi behtar hai. Ye comma-separated list sirf pehle-run fallback.)
# Multiple proxies = multiple IPs = WAF/rate-limit par ZERO wait (IP rotate).
# Formats: host:port | http://user:pass@host:port | socks5://host:port
# PROXIES=1.2.3.4:8080,5.6.7.8:3128

# --- 🌐 Free proxies auto-fetch (default ON) ---
# Asal usable proxies kam hon to batch-start/mid-run par bot 18 public free lists
# se candidates merge karke generic HTTPS + Swiggy-tested proxies daal deta hai (target ~30 usable).
# Band karna ho to 0 (ya bot me Settings → Proxies → 🌐 Free Auto OFF):
# PREMIUM_AUTO_FREE_PROXIES=1
# Apni proxy-list URLs (JSON/array ya text lines) — default sources ke saath merge hongi:
# PREMIUM_PROXY_SOURCES=https://example.com/my-proxies.txt
# Fresh account ka Maharashtra candidate pehle asal authenticated Swiggy
# /web-cart-add-address page par SAVE + saved-list verify hota hai. CAS
# fallback default me guessed /mapi ya /dapi URL par blind POST nahi karta.
# Sirf pakka/exact central-address create URL maloom ho tabhi yahan do:
# SWIGGY_ADDRESS_CREATE_URL=https://www.swiggy.com/mapi/addresses/v1

# ---- Firebase (OPTIONAL — bot ke ⚙️ Settings → Firebase Sources se ek saath
# multiple DB add kar sakte hain. Har added DB Delete tak hamesha ACTIVE
# rehta hai; ye values sirf pehle-run fallback hain) ----
# Batch current source se Numbers + OTP leta hai aur zaroorat par baaki
# ACTIVE sources auto-try karta hai.
FIREBASE_DB_URL=https://vuvhbjbi-default-rtdb.firebaseio.com/
# 🔥 POORI LIST (recommended, Render restart-proof): jitni chaho Firebase
# URLs comma/newline se alag karke daal do. Boot par jo missing hongi woh
# auto-add ho jayengi (Delete ki hui URL wapas nahi aati). Bot ke andar
# Settings → Firebase Sources → Add Firebase (Bulk) me bhi ek message me
# 1000 tak URLs paste ho sakte hain. Owner ki ROLEX VIP list (600+) code
# me built-in hai, isliye pehle boot par apne aap add ho jati hai.
# FIREBASE_DB_URLS=https://one-default-rtdb.firebaseio.com,https://two-default-rtdb.firebaseio.com
# Source health: jo DB 2 baar fail/khali nikli woh 30 min quarantine me
# chali jati hai (list se hatti nahi — sirf try-order me peeche aati hai),
# isliye har run pehle zinda DBs try karta hai.
# Agar rules open na hon to DB secret yahan daalo:
FIREBASE_DB_AUTH=
# Structure knobs (default theek hain):
FIREBASE_CLIENTS_PATH=clients
FIREBASE_MESSAGES_PATH=messages

# ---- 📨 Telegram Hermes OTP source (Telegram-only mode) ----
# Recommended: Render par kuch session paste karne ki zaroorat nahi —
# Telegram me bot kholo → ⚙️ Settings → 👤 Add Telegram Account → spare/faltu
# account yahin login karo. Bot env me API ID/hash na ho to private chat me
# sirf woh maangega (my.telegram.org → API development tools). Phir spare
# phone, Telegram login code aur agar 2FA ho to password lagega. Sensitive
# input messages delete karne ki koshish hogi; session kabhi chat me nahi
# dikhegi.
#
# NUMBER_SOURCE=telegram  → hamesha Telegram/@HermeshuOTPROBOT only
# NUMBER_SOURCE=firebase  → purana Firebase-only flow
# IMPORTANT: Bot ke Settings me Hermes Mode ON ho to wahi locked source hai;
# Render par purana NUMBER_SOURCE=firebase reh jaye tab bhi Hermes batch
# Firebase try nahi karega. Khali chhodo to bot setting/configured Telegram
# decide karega.
# NUMBER_SOURCE=telegram
# Hermeshu ke baad Swiggy OTP ka one-shot REFRESH wait (default
# 20000ms = 20s) aur refresh-check gap (default 2500ms). OTP failure par
# wahi number dobara try nahi hota; batch agle NEW NUMBER par jati hai.
# Dono wait values ⚙️ Settings se bhi badal sakte hain.
# TELEGRAM_OTP_TIMEOUT_MS=20000
# TELEGRAM_OTP_REFRESH_MS=2500
# ---- Teen OTP bots supported (sab ek hi spare session se) ----
#   @HermeshuOTPROBOT — FIND NUMBER → card → REFRESH   (default)
#   @Hathi_otp_bot    — Hermes jaisa hi (FIND/NEW NUMBER → REFRESH)
#   @HardXotp_Bot     — GET NUMBERS → ASSIGNED NUMBER → VIEW MESSAGES
# START dabane par bot khud poochhta hai kaunsa source chahiye (Hermes /
# Hathi / HardXotp / Firebase) — env me kuch likhna zaroori nahi. Choice bot ke
# Settings me save rehti hai (db.freshSettings.otpBotProfile).
# Manual override (custom/third bot) chahiye tabhi ye set karo:
# TELEGRAM_OTP_BOT_USERNAME=HermeshuOTPROBOT
# Har naye number par Swiggy OTP bhejne ke baad itni der OTP dekha jata hai;
# OTP na aaye to wahi number chhod kar NEW NUMBER (HardXotp me bhi NEW NUMBER)
# se agla number liya jata hai.
#
# Advanced/durable env route: local PC par `npm run telegram:login` karke
# session banao to use Render env me rakh sakte ho. YE FULL ACCOUNT ACCESS
# HAI — GitHub/chat/screenshot me kabhi mat bhejo; spare account hi use karo.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION=
# Bot ke andar login se files default data/telegram.session aur
# data/telegram-api.json (0600) me save hoti hain. Free Render disk restart/
# redeploy par mit sakti hai; long-term ke liye env session zyada durable hai.
# TELEGRAM_SESSION_FILE=data/telegram.session
# TELEGRAM_API_CREDENTIALS_FILE=data/telegram-api.json

# ---- Render Free Web Service keep-alive (optional) ----
# Render par RENDER_EXTERNAL_URL auto milta hai, isliye aam taur par kuch
# set karne ki zaroorat nahi. Bot har 5 min public /health ko ping karke
# 15-min free-instance neend rokta hai. URL manual dena ho to:
# KEEP_ALIVE_URL=https://your-service.onrender.com/health
# KEEP_ALIVE_INTERVAL_MINUTES=5
# Band karna ho to: KEEP_ALIVE=0
# External cron backup bhi isi /health URL par GET har 5-10 min lagao.

# ---- Cloud vault (optional — sessions cloud me bhejne ke liye) ----
# GITHUB_VAULT_TOKEN=
# VAULT_ENCRYPTION_KEY=
# DISABLE_CLOUD_VAULT=1
