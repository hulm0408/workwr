# Vercel (container project) ke liye entry — Gold Drop ka browser mode
#
# Kyun: `workwr` project Vercel par **container** type ka hai, isliye usko
# Dockerfile/Docker image chahiye. Aur Gold Drop ka security check sirf
# asli browser me clear hota hai (raw HTTP API par solved token ke bawajood
# site 400 deti hai).
#
# Ye image repo root ke Dockerfile se banti hai — usme Node 22 + Google Chrome
# + Python 3 + SeleniumBase + Playwright already hain, jo gold_drop_stealth.py
# ko chahiye. Yahan sirf CMD badal kar web server (bot-hub-vercel) chalaya
# jaata hai, taaki browser + OTP dono ek hi jagah se chalein.
FROM node:22-bookworm-slim

# Chrome (Gold Drop ka asli browser flow + Swiggy WAF ke liye)
RUN set -eux; \
    apt-get -o Acquire::Retries=3 update; \
    apt-get install -y --no-install-recommends wget ca-certificates fonts-liberation; \
    wget --tries=5 --waitretry=5 --timeout=30 \
      -O /tmp/google-chrome-stable.deb \
      https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb; \
    apt-get install -y --no-install-recommends /tmp/google-chrome-stable.deb; \
    rm -f /tmp/google-chrome-stable.deb; \
    rm -rf /var/lib/apt/lists/*; \
    google-chrome-stable --version

ENV NODE_ENV=production \
    HEADLESS=1 \
    PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# Gold Drop stealth stack (SeleniumBase CDP + Playwright) + xvfb (headed mode)
RUN set -eux; \
    apt-get -o Acquire::Retries=3 update; \
    apt-get install -y --no-install-recommends python3 python3-venv xvfb libatomic1; \
    rm -rf /var/lib/apt/lists/*; \
    python3 -m venv /opt/golddrop-venv; \
    /opt/golddrop-venv/bin/pip install --no-cache-dir --upgrade pip; \
    /opt/golddrop-venv/bin/pip install --no-cache-dir seleniumbase playwright; \
    /opt/golddrop-venv/bin/sbase get uc_driver || echo "uc_driver pehli run par download hoga"

ENV GOLD_DROP_PYTHON=/opt/golddrop-venv/bin/python

WORKDIR /app

# Repo root ke deps (teleproto lazy import ke liye) + hub ke deps
COPY package.json package-lock.json ./
RUN npm ci --omit=dev \
      --fetch-retries=5 \
      --fetch-retry-mintimeout=20000 \
      --fetch-retry-maxtimeout=120000 \
      --fetch-timeout=300000

COPY . .

WORKDIR /app/bot-hub-vercel
RUN npm install --omit=dev --no-audit --no-fund \
      --fetch-retries=5 \
      --fetch-timeout=300000

# Build par hi verify: worker syntax + hub handler importable
RUN /opt/golddrop-venv/bin/python -m py_compile /app/gold_drop_stealth.py \
    && node --input-type=module -e "await import('./api/index.js'); console.log('hub handler OK')"

ENV PORT=3000
EXPOSE 3000
CMD ["node", "api/index.js"]
